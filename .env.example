# ALBRA - Environment
# Copy to .env and fill real values. NEVER commit .env.

# --- Identity ---
ALBRA_AGENT_NAME="DESPACHO JURÍDICO DIGITAL ALBRA"
ALBRA_AGENT_VERSION="1.0.0"
ALBRA_ENVIRONMENT=development

# --- Runtime ---
ALBRA_RUNTIME_LOOP_MAX_ITER=20
ALBRA_RUNTIME_TIMEOUT_SECONDS=120

# --- Memory (memorydv) ---
ALBRA_MEMORY_BACKEND=sqlite  # sqlite | chroma | inmemory
ALBRA_MEMORY_PATH=./data/memory.db
ALBRA_MEMORY_EMBEDDING_MODEL=hash  # hash | openai | local
ALBRA_MEMORY_VECTOR_DIM=256

# --- Providers (LLM) ---
ALBRA_DEFAULT_PROVIDER=mock  # mock | openai | anthropic
ALBRA_OPENAI_API_KEY=
ALBRA_ANTHROPIC_API_KEY=

# --- Comms ---
ALBRA_WHATSAPP_ENABLED=false
ALBRA_WHATSAPP_TOKEN=
ALBRA_WHATSAPP_PHONE_ID=
ALBRA_TELEGRAM_ENABLED=false
ALBRA_TELEGRAM_BOT_TOKEN=

# --- Security ---
ALBRA_JWT_SECRET=change-me-in-production
ALBRA_ADMIN_PASSWORD=change-me

# --- OIDC / OAuth 2.0 (V6.0) ---
# Production bearer validation is OFF by default. When OIDC_ENABLED=true,
# every production bearer token is validated against the configured IdP.
# When OIDC_ENABLED=false (or unset), production mode rejects every
# bearer (fail-closed — preserves V5.2 behavior).
ALBRA_ENVIRONMENT=development  # development | production
OIDC_ENABLED=false  # true | false — master switch
OIDC_ISSUER=  # e.g. https://albra.us.auth0.com/ — REQUIRED when OIDC_ENABLED=true
OIDC_AUDIENCE=  # e.g. https://api.albra.dev — REQUIRED when OIDC_ENABLED=true
OIDC_CLIENT_ID=  # optional; some IdPs include this in aud
OIDC_JWKS_URL=  # optional override; defaults to {OIDC_ISSUER}/.well-known/jwks.json
OIDC_CLOCK_SKEW_SECONDS=60  # tolerance for exp/nbf checks
OIDC_JWKS_TIMEOUT_SECONDS=5  # network timeout for JWKS fetch
OIDC_JWKS_CACHE_TTL_SECONDS=600  # JWKS cache TTL (key rotation window)
# Trusted role claim namespace + name. Default follows Auth0 convention.
OIDC_ROLE_NAMESPACE=https://albra.dev
OIDC_ROLE_CLAIM=role
# Tenant map: {stable_id: tenant_id}. stable_id = SHA-256(issuer||subject).
# Configure via inline JSON OR a file path. Production MUST configure
# at least one of these; otherwise every valid token is denied.
OIDC_TENANT_MAP=  # inline JSON, e.g. {"abc123...": "tenant-A"}
OIDC_TENANT_MAP_PATH=  # path to JSON file with the same structure

# --- Observability ---
ALBRA_LOG_LEVEL=INFO
ALBRA_LOG_FORMAT=console  # console | json
ALBRA_AUDIT_PATH=./data/audit.log

# --- Knowledge (future) ---
ALBRA_KNOWLEDGE_JURISDICTION=CO
ALBRA_KNOWLEDGE_PATH=./data/knowledge
